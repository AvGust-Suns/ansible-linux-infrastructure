---
global:
  scrape_interval: "{{ prometheus_scrape_interval }}"
  evaluation_interval: "{{ prometheus_scrape_interval }}"

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets:
          - localhost:9090

  - job_name: linux_nodes
    static_configs:
      - targets:
{% for target in prometheus_node_targets %}
          - "{{ target }}"
{% endfor %}
